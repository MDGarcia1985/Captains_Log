# Public environment template. Copy to `.env.local` (gitignored).
# Never put passwords, AWS access keys, OAuth client secrets, or
# authority signing keys in this file or anywhere else in this repository.
#
# Local AWS access uses the CLI default profile and `aws login`
# (short-lived credentials). The SDK default credential provider chain
# is the only supported local/runtime AWS auth path.

AWS_PROFILE=default
AWS_REGION=us-east-2
AWS_SDK_LOAD_CONFIG=1

# Identifiers only. Live values belong in captains-log-infra.
# Do not paste secret ARNs with account IDs into this public repo.
CL_ENVIRONMENT=
RDS_ENDPOINT=
RDS_PORT=5432
RDS_DATABASE=captains_log
RDS_SECRET_ARN=
ECR_REPOSITORY=
ECS_CLUSTER=
ECS_SERVICE=
ECS_TASK_DEFINITION=
ECS_TASK_ROLE_ARN=
ECS_EXECUTION_ROLE_ARN=
AWS_DEPLOY_ROLE_ARN=

# Private npm registry token for Universal Google Sign-In (operator).
# Export in the shell; do not write the token into .npmrc.
NPM_TOKEN_GOOGLE_SIGN_IN=
