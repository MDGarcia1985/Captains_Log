{
  "expo": {
    "name": "Captain's Log",
    "slug": "captainslog",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "captainslog",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.captainslog.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Captain's Log uses the camera when you capture a photo for a log entry.",
        "NSPhotoLibraryUsageDescription": "Captain's Log attaches photos you choose to log entries.",
        "NSLocationWhenInUseUsageDescription": "Captain's Log records location only when you attach it to an entry."
      }
    },
    "android": {
      "package": "com.captainslog.app",
      "adaptiveIcon": {
        "backgroundColor": "#070B12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            },
            {
              "mimeType": "image/*"
            },
            {
              "mimeType": "application/pdf"
            },
            {
              "mimeType": "*/*"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070B12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Captain's Log attaches photos you choose to log entries.",
          "cameraPermission": "Captain's Log uses the camera when you capture a photo for a log entry."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Captain's Log records location only when you attach it to an entry."
        }
      ]
    ],
    "extra": {
      "googleWebClientId": "",
      "googleIosClientId": "",
      "googleAndroidClientId": "",
      "router": {},
      "eas": {
        "projectId": "67017de0-1f10-4441-a60e-0d1f78ee2efa"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "mande-design"
  }
}
